{
  "expo": {
    "name": "AdaptaLearn",
    "slug": "adaptalearn",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "adaptalearn",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
